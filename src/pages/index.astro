---
import "@fontsource-variable/unbounded";
import "@fontsource-variable/manrope";
import "@fontsource-variable/jetbrains-mono";
import "../styles/tokens.css";
import "../styles/landing.css";

// The pact in the hero is real: opened, judged by the hosted verifier and settled on testnet.
const PACT = "4072556402d709463f7cb888a4a9e03b061d906f0b7ca5c49ebb2eec4e7d5c55";
const tx = (hash: string) => `https://stellar.expert/explorer/testnet/tx/${hash}`;
const steps = [
  { stamp: "Opened", ink: "indigo", ledger: 5453755, text: "1.00 USDC locked in escrow.", hash: "b01031165b23c378d3fa9f5c9befbee0b1a733d944a89e1ce13e17ff290d1a5d" },
  { stamp: "Allowed", ink: "teal", ledger: 5453761, text: "The verifier read the translation and approved 1.00 USDC.", hash: "0225f78b5c3e9b321e1fd5311bc54a61ca9904fa82dbd2b4aeb9f379bc8650db" },
  { stamp: "Settled", ink: "teal", ledger: 5453762, text: "1.00 USDC to the seller, 0.00 back to the buyer.", hash: "1f4ab38c3881892633c2dcf8d7c99c22bc49831d09512eb1b700e62e23e44924" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pactwright: refunds for AI-agent purchases</title>
    <meta name="description" content="Refunds for AI-agent purchases on Stellar. The money waits in escrow until a verifier checks the delivery; what wasn't delivered goes back automatically." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta property="og:title" content="Pactwright" />
    <meta property="og:description" content="Refunds for AI-agent purchases on Stellar: escrow, verdicts and receipts." />
    <meta property="og:image" content="https://pactwright.github.io/pactwright-mark.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content="https://pactwright.github.io/pactwright-mark.png" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <a class="brand" href="/"><img src="/pactwright-mark.png" alt="" width="40" height="40" />Pactwright</a>
      <nav aria-label="Site">
        <a href="/docs/">Docs</a>
        <a href="/docs/quickstart/">Quickstart</a>
        <a href="/docs/project/status/">Status</a>
        <a href="https://github.com/Pactwright">GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-copy">
          <h1>Every agent purchase is a pact.</h1>
          <p class="lede">
            When an AI agent pays for something, Pactwright holds the money in escrow on Stellar until a verifier checks the
            delivery against terms agreed before payment. The seller is paid what the delivery earned; the rest goes back.
          </p>
          <div class="actions">
            <a class="cta" href="/docs/">Read the docs</a>
            <a class="quiet" href="/docs/concepts/lifecycle/">How a pact works</a>
          </div>
          <p class="fine"><span class="live-dot" aria-hidden="true"></span>Live on Stellar testnet. Not audited yet.</p>
        </div>

        <article class="panel pact-card" aria-label="A real pact on testnet">
          <header class="card-head">
            <div>
              <span class="label">Pact ID</span>
              <p class="pact-id mono">{PACT}</p>
            </div>
            <span class="seal" role="img" aria-label="Pactwright mark"><img src="/pactwright-mark.png" alt="" width="84" height="84" /></span>
          </header>
          <span class="stamp stamp--large" data-ink="teal">Settled</span>
          <dl class="fields">
            <div><dt class="label">Bought</dt><dd class="mono">A 4-page Portuguese translation</dd></div>
            <div><dt class="label">Cap</dt><dd class="mono">1.00 USDC</dd></div>
            <div><dt class="label">Paid to the seller</dt><dd class="mono">1.00 USDC</dd></div>
            <div><dt class="label">Returned to the buyer</dt><dd class="mono">0.00 USDC</dd></div>
            <div><dt class="label">Judged by</dt><dd class="mono">The hosted verifier, gemini-3.5-flash-lite</dd></div>
            <div><dt class="label">If no verdict in time</dt><dd class="mono">Refund the buyer</dd></div>
          </dl>
          <p class="card-foot">
            A real pact on testnet, 29 October 2026.{" "}
            <a href={`https://pactwright-studio.vercel.app/pact/${PACT}`}>See it in Studio</a>
          </p>
        </article>
      </section>

      <section class="band" id="simulator" aria-labelledby="sim-title">
        <div class="band-header">
          <h2 id="sim-title" class="band-title">Try the settlement simulator</h2>
          <p class="band-intro">
            Toggle between scenarios to see how Soroban smart contract escrow settles on Stellar in real time—from full delivery to partial completions, hallucinations, and timeouts.
          </p>
        </div>

        <div class="simulator-stage" data-ui aria-label="Interactive Settlement Simulator">
          <div class="simulator-tabs-bar" role="tablist" aria-label="Simulation Scenarios">
            <button
              type="button"
              class="sim-tab active"
              role="tab"
              aria-selected="true"
              data-scenario="full"
              id="tab-full"
            >
              Full Delivery (100%)
            </button>
            <button
              type="button"
              class="sim-tab"
              role="tab"
              aria-selected="false"
              data-scenario="partial"
              id="tab-partial"
            >
              Partial (75% / 25%)
            </button>
            <button
              type="button"
              class="sim-tab"
              role="tab"
              aria-selected="false"
              data-scenario="denied"
              id="tab-denied"
            >
              Hallucinated (Refund)
            </button>
            <button
              type="button"
              class="sim-tab"
              role="tab"
              aria-selected="false"
              data-scenario="timeout"
              id="tab-timeout"
            >
              Timeout (Silence)
            </button>
          </div>

          <div class="simulator-body">
            <div class="sim-meta-header">
              <div class="sim-id-block">
                <span class="label">Simulated Pact ID</span>
                <p class="pact-id mono" id="sim-pact-id">{PACT}</p>
                <div style="margin-top: 10px;">
                  <span class="stamp stamp--large" id="sim-stamp" data-ink="teal">Settled</span>
                </div>
              </div>
              <div class="sim-seal-wrap" role="img" aria-label="Pactwright mark">
                <img src="/pactwright-mark.png" alt="" width="68" height="68" />
              </div>
            </div>

            <!-- Pipeline Visual -->
            <div class="sim-pipeline">
              <div class="sim-pipe-step">
                <span class="label">1. Locked Escrow</span>
                <span class="sim-pipe-val mono" id="sim-pipe-cap">1.00 USDC</span>
              </div>
              <div class="sim-pipe-step">
                <span class="label">2. Verifier Verdict</span>
                <span class="sim-pipe-val mono" id="sim-pipe-verdict">ALLOW 1.00</span>
              </div>
              <div class="sim-pipe-step">
                <span class="label">3. Settlement Execution</span>
                <span class="sim-pipe-val mono" id="sim-pipe-action">Full Seller Payout</span>
              </div>
            </div>

            <!-- Balances -->
            <div class="sim-balances">
              <div class="sim-balance-card">
                <span class="label">Paid to Seller</span>
                <span class="sim-balance-amount seller-amount mono" id="sim-seller-amount">1.00 USDC</span>
              </div>
              <div class="sim-balance-card">
                <span class="label">Refunded to Buyer</span>
                <span class="sim-balance-amount refund-amount mono" id="sim-buyer-amount">0.00 USDC</span>
              </div>
            </div>

            <div class="sim-verdict-quote" id="sim-quote">
              "The hosted verifier validated translation quality: 4 of 4 pages approved. 1.00 USDC paid to seller."
            </div>

            <div class="sim-footer">
              <span class="mono" id="sim-hash-meta">Testnet Ledger #5453762 · Settle Tx: 1f4ab38c…</span>
              <a href={`https://pactwright-studio.vercel.app/pact/${PACT}`} target="_blank" rel="noreferrer">
                Inspect in Studio Explorer ↗
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="band" aria-labelledby="wrong-title">
        <div class="panel">
          <h2 id="wrong-title">What happens when a purchase goes wrong</h2>
          <p class="prose">An agent has no one to call. So the rules for getting money back are part of the payment.</p>
          <table class="ledger">
            <thead><tr><th scope="col">If</th><th scope="col">Then</th></tr></thead>
            <tbody>
              <tr><td>The delivery is wrong</td><td>The verifier signs DENY and the buyer gets the whole cap back</td></tr>
              <tr><td>Only part arrives</td><td>The seller is paid for what arrived; the rest returns, in the same transaction</td></tr>
              <tr><td>Nothing arrives</td><td>No verdict comes, and after the deadline the money goes back to the buyer</td></tr>
              <tr><td>The verifier goes silent</td><td>The same: the silence policy agreed up front applies</td></tr>
              <tr><td>The seller never collects</td><td>After the settle deadline, anyone can return the money to the buyer</td></tr>
              <tr><td>Someone forges or replays a verdict</td><td>Rejected: each verdict is signed and bound to one pact and one set of terms</td></tr>
            </tbody>
          </table>
          <p class="prose small">Nobody can move the escrow outside these rules. Not the seller, not the verifier, not the admin: there is no function that could.</p>
        </div>
      </section>

      <section class="band" aria-labelledby="steps-title">
        <h2 id="steps-title" class="band-title">The same pact, step by step</h2>
        <ol class="chain">
          {steps.map((s) => (
            <li class="block">
              <div class="block-head">
                <span class="stamp" data-ink={s.ink}>{s.stamp}</span>
                <span class="block-height mono">Ledger {s.ledger}</span>
              </div>
              <div class="block-body">
                <p>{s.text}</p>
                <a class="mono" href={tx(s.hash)}>{s.hash.slice(0, 8)}…{s.hash.slice(-8)}</a>
              </div>
            </li>
          ))}
        </ol>
        <p class="band-note">
          Then the outcome becomes a receipt, anchored on-chain in a batch, so anyone can check later what was paid and why.
        </p>
      </section>

      <section class="band" aria-labelledby="who-title">
        <h2 id="who-title" class="band-title">Where to start</h2>
        <div class="tiles">
          <a class="tile" href="/docs/guides/agent/">
            <h3>You build agents</h3>
            <p>Find a seller, buy under a pact, wait for the verdict and keep the certificate. As a TypeScript SDK or as MCP tools.</p>
            <span class="go">Buy as an agent</span>
          </a>
          <a class="tile" href="/docs/guides/seller/">
            <h3>You sell an API</h3>
            <p>One middleware call puts a route behind a pact: terms in the 402, payment checked before you serve, a signed receipt after.</p>
            <span class="go">Sell behind a pact</span>
          </a>
          <a class="tile" href="/docs/concepts/trust/">
            <h3>You want to check it</h3>
            <p>Who can do what, what the contract guarantees, the known limits, and the testnet transactions behind every claim.</p>
            <span class="go">Who you have to trust</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-foot">
      <p>
        Chat: <a href="https://discord.gg/4WFU6fwPe">Discord</a> · <a href="https://t.me/Pactwright">Telegram</a>.
        We will never DM you first, and there is no token or airdrop. Vulnerabilities go through a repo's
        <code>SECURITY.md</code>, never chat.
      </p>
      <p>
        Pactwright is open source:{" "}
        <a href="https://github.com/Pactwright/Pactwright-contracts">contracts</a> (MIT),{" "}
        <a href="https://github.com/Pactwright/Pactwright-Kit">Kit</a> (Apache-2.0) and{" "}
        <a href="https://github.com/Pactwright/Pactwright-studio">Studio</a> (MIT). Built on Witness, Accensa and Tollcraft.
      </p>
      <p>Runs on Stellar testnet. Not audited, so don't put real money in it yet.</p>
    </footer>

    <script>
      // Scenario definitions for Simulator
      const scenarios = {
        full: {
          cap: "1.00 USDC",
          verdict: "ALLOW 1.00",
          action: "Full Seller Payout",
          seller: "1.00 USDC",
          buyer: "0.00 USDC",
          stampText: "Settled",
          stampInk: "teal",
          quote: "The hosted verifier validated translation quality: 4 of 4 pages approved. 1.00 USDC paid to seller.",
          hashMeta: "Testnet Ledger #5453762 · Settle Tx: 1f4ab38c…",
        },
        partial: {
          cap: "1.00 USDC",
          verdict: "ALLOW 0.75",
          action: "Atomic 75/25 Split",
          seller: "0.75 USDC",
          buyer: "0.25 USDC",
          stampText: "Partial Settle",
          stampInk: "indigo",
          quote: "Verifier approved 3 of 4 delivered pages (0.75 USDC). 0.25 USDC returned to buyer in the same ledger transaction.",
          hashMeta: "Testnet Ledger #5453910 · Settle Tx: a40f92b1…",
        },
        denied: {
          cap: "1.00 USDC",
          verdict: "DENY 0.00",
          action: "Full Buyer Refund",
          seller: "0.00 USDC",
          buyer: "1.00 USDC",
          stampText: "Full Refund",
          stampInk: "rose",
          quote: "Payload failed schema validation (corrupt output). Verifier signed DENY: 100% of cap refunded immediately.",
          hashMeta: "Testnet Ledger #5454045 · Settle Tx: 7820ec19…",
        },
        timeout: {
          cap: "1.00 USDC",
          verdict: "NO VERDICT",
          action: "Timeout Reclaim",
          seller: "0.00 USDC",
          buyer: "1.00 USDC",
          stampText: "Timeout Refund",
          stampInk: "amber",
          quote: "Seller server dropped offline. Timeout deadline reached: buyer called reclaim to retrieve full 1.00 USDC.",
          hashMeta: "Testnet Ledger #5454180 · Reclaim Tx: e891d45a…",
        },
      };

      // Wire simulator tabs
      const simTabs = document.querySelectorAll<HTMLButtonElement>(".sim-tab");
      const pipeCap = document.getElementById("sim-pipe-cap");
      const pipeVerdict = document.getElementById("sim-pipe-verdict");
      const pipeAction = document.getElementById("sim-pipe-action");
      const sellerAmount = document.getElementById("sim-seller-amount");
      const buyerAmount = document.getElementById("sim-buyer-amount");
      const stamp = document.getElementById("sim-stamp");
      const quote = document.getElementById("sim-quote");
      const hashMeta = document.getElementById("sim-hash-meta");

      simTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          simTabs.forEach((t) => {
            t.classList.remove("active");
            t.setAttribute("aria-selected", "false");
          });
          tab.classList.add("active");
          tab.setAttribute("aria-selected", "true");

          const key = tab.getAttribute("data-scenario") as keyof typeof scenarios;
          const data = scenarios[key];
          if (!data) return;

          if (pipeCap) pipeCap.textContent = data.cap;
          if (pipeVerdict) pipeVerdict.textContent = data.verdict;
          if (pipeAction) pipeAction.textContent = data.action;
          if (sellerAmount) sellerAmount.textContent = data.seller;
          if (buyerAmount) buyerAmount.textContent = data.buyer;
          if (quote) quote.textContent = `"${data.quote}"`;
          if (hashMeta) hashMeta.textContent = data.hashMeta;

          if (stamp) {
            stamp.textContent = data.stampText;
            stamp.setAttribute("data-ink", data.stampInk);
            stamp.style.animation = "none";
            stamp.offsetHeight; // trigger reflow
            stamp.style.animation = "";
          }
        });
      });
    </script>
  </body>
</html>
