---
import "@fontsource-variable/unbounded";
import "@fontsource-variable/manrope";
import "@fontsource-variable/jetbrains-mono";
import "../styles/tokens.css";
import "../styles/landing.css";

const PACT = "4072556402d709463f7cb888a4a9e03b061d906f0b7ca5c49ebb2eec4e7d5c55";
const tx = (hash: string) => `https://stellar.expert/explorer/testnet/tx/${hash}`;

const steps = [
  {
    num: "01",
    stamp: "Opened",
    ink: "indigo",
    ledger: 5453755,
    title: "1.00 USDC locked in Soroban escrow",
    text: "Buyer signs the pact terms negotiated over HTTP 402. Contract holds 1.00 USDC in non-custodial storage until verifier evaluates.",
    hash: "b01031165b23c378d3fa9f5c9befbee0b1a733d944a89e1ce13e17ff290d1a5d",
    state: "EscrowLocked",
    payload: { buyer: "GA7Q...3Z21", cap: "1.00 USDC", timeout: "300s", verifier: "https://verifier.pactwright.org" },
  },
  {
    num: "02",
    stamp: "Allowed",
    ink: "teal",
    ledger: 5453761,
    title: "Hosted verifier approved 1.00 USDC",
    text: "The verifier inspected the 4-page translation deliverable, verified semantic completeness, and signed an ed25519 attestation.",
    hash: "0225f78b5c3e9b321e1fd5311bc54a61ca9904fa82dbd2b4aeb9f379bc8650db",
    state: "AttestationSigned",
    payload: { verdict: "ALLOW", amount_allowed: "1.00 USDC", signer_key: "ed25519:v_891...3a", deliverable_sha256: "9f83...bc01" },
  },
  {
    num: "03",
    stamp: "Settled",
    ink: "teal",
    ledger: 5453762,
    title: "1.00 USDC to seller, 0.00 USDC refund",
    text: "Soroban contract validates verifier signature on-chain, disburses 1.00 USDC to seller, and anchors receipt leaf into batch Merkle root.",
    hash: "1f4ab38c3881892633c2dcf8d7c99c22bc49831d09512eb1b700e62e23e44924",
    state: "AtomicSettled",
    payload: { seller_payout: "1.00 USDC", buyer_refund: "0.00 USDC", receipt_root: "e3b0c442...9821", status: "Closed" },
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pactwright: Design Options Preview (Port 4322)</title>
    <meta name="description" content="Explore mature design directions for the Pactwright on-chain timeline and settlement architecture." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content="Pactwright Design Options" />
    <style>
      /* Options Switcher Bar */
      .options-top-bar {
        position: sticky;
        top: 0;
        z-index: 100;
        background: #090e1f;
        border-bottom: 1px solid var(--hairline-strong);
        padding: 12px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .options-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--display);
        font-size: 0.9375rem;
        font-weight: 700;
        color: var(--text-strong);
      }

      .options-badge {
        font-family: var(--mono-face);
        font-size: 0.75rem;
        background: rgba(45, 212, 191, 0.12);
        color: var(--teal);
        border: 1px solid rgba(45, 212, 191, 0.3);
        padding: 3px 8px;
        border-radius: 6px;
      }

      .options-nav {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .option-btn {
        background: rgba(22, 32, 66, 0.6);
        border: 1px solid var(--hairline);
        color: var(--muted);
        font-family: var(--text-face);
        font-size: 0.875rem;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 120ms ease;
      }

      .option-btn:hover {
        color: var(--text-strong);
        border-color: var(--hairline-strong);
      }

      .option-btn.active {
        background: var(--surface-raised);
        border-color: var(--teal);
        color: var(--text-strong);
        box-shadow: 0 0 16px -4px rgba(45, 212, 191, 0.3);
      }

      .variant-view {
        display: none;
      }

      .variant-view.active {
        display: block;
      }

      /* Option 1: Institutional Protocol Ledger */
      .inst-ledger-wrap {
        border-radius: 18px;
        border: 1px solid var(--hairline-strong);
        background: rgba(11, 17, 36, 0.85);
        overflow: hidden;
      }

      .inst-ledger-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        border-bottom: 1px solid var(--hairline);
        background: rgba(8, 13, 28, 0.9);
        font-family: var(--mono-face);
        font-size: 0.8125rem;
        color: var(--muted);
      }

      .inst-ledger-table {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .inst-ledger-row {
        display: grid;
        grid-template-columns: 140px 180px 1fr 140px;
        align-items: center;
        gap: 16px;
        padding: 18px 24px;
        border-bottom: 1px solid var(--hairline);
        transition: background 120ms ease;
      }

      .inst-ledger-row:last-child {
        border-bottom: none;
      }

      .inst-ledger-row:hover {
        background: rgba(22, 32, 66, 0.35);
      }

      .inst-badge {
        font-family: var(--mono-face);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 6px;
        width: fit-content;
      }

      .inst-badge.teal {
        background: rgba(45, 212, 191, 0.12);
        color: var(--teal);
        border: 1px solid rgba(45, 212, 191, 0.3);
      }

      .inst-badge.indigo {
        background: rgba(129, 140, 248, 0.12);
        color: #a5b4fc;
        border: 1px solid rgba(129, 140, 248, 0.3);
      }

      .inst-ledger-meta {
        font-family: var(--mono-face);
        font-size: 0.8125rem;
        color: var(--muted);
      }

      .inst-ledger-body p {
        margin: 0;
        font-size: 0.9375rem;
        color: var(--text-strong);
        font-weight: 500;
      }

      .inst-ledger-tx a {
        font-family: var(--mono-face);
        font-size: 0.8125rem;
        color: var(--link);
        text-decoration: none;
      }

      .inst-ledger-tx a:hover {
        text-decoration: underline;
      }

      /* Option 2: Godly Editorial Cards */
      .editorial-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }

      .editorial-card {
        background: var(--surface);
        border: 1px solid var(--glass-edge);
        border-radius: 16px;
        padding: 28px 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        transition: transform 120ms ease, border-color 120ms ease;
      }

      .editorial-card:hover {
        border-color: var(--teal);
        transform: translateY(-2px);
      }

      .editorial-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
      }

      .editorial-num {
        font-family: var(--display);
        font-size: 2rem;
        font-weight: 700;
        color: rgba(140, 150, 179, 0.35);
        line-height: 1;
      }

      .editorial-card h3 {
        margin: 0 0 10px;
        font-family: var(--display);
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text-strong);
      }

      .editorial-card p {
        margin: 0 0 20px;
        font-size: 0.9375rem;
        color: var(--muted);
        line-height: 1.55;
      }

      .editorial-foot {
        padding-top: 16px;
        border-top: 1px solid var(--hairline);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.8125rem;
      }

      /* Option 3: Cryptographic State Machine */
      .state-dag-flow {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 24px;
      }

      .state-node-btn {
        background: rgba(13, 20, 40, 0.7);
        border: 1px solid var(--hairline);
        border-radius: 12px;
        padding: 18px 20px;
        text-align: left;
        cursor: pointer;
        transition: all 120ms ease;
      }

      .state-node-btn:hover {
        border-color: var(--hairline-strong);
      }

      .state-node-btn.active {
        border-color: var(--teal);
        background: rgba(45, 212, 191, 0.08);
      }

      .state-node-label {
        display: block;
        font-family: var(--mono-face);
        font-size: 0.75rem;
        color: var(--muted);
        margin-bottom: 6px;
      }

      .state-node-name {
        font-family: var(--display);
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-strong);
      }

      .state-payload-inspector {
        background: #060914;
        border: 1px solid var(--hairline-strong);
        border-radius: 14px;
        padding: 24px;
        font-family: var(--mono-face);
        font-size: 0.875rem;
      }

      .state-payload-title {
        color: var(--teal);
        font-size: 0.8125rem;
        margin-bottom: 12px;
        display: block;
      }

      .state-payload-inspector pre {
        margin: 0;
        color: #cad2ea;
        line-height: 1.6;
        overflow-x: auto;
      }

      @media (max-width: 860px) {
        .inst-ledger-row {
          grid-template-columns: 1fr;
          gap: 10px;
        }
        .editorial-grid,
        .state-dag-flow {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <!-- Top Interactive Variant Picker -->
    <aside class="options-top-bar" aria-label="Variant Switcher">
      <div class="options-brand">
        <span>Timeline Design Options</span>
        <span class="options-badge">Port 4322 Preview</span>
      </div>
      <div class="options-nav" role="tablist">
        <button type="button" class="option-btn active" role="tab" data-variant="opt1" id="btn-opt1">
          1. Institutional Ledger
        </button>
        <button type="button" class="option-btn" role="tab" data-variant="opt2" id="btn-opt2">
          2. Godly Editorial Cards
        </button>
        <button type="button" class="option-btn" role="tab" data-variant="opt3" id="btn-opt3">
          3. Cryptographic State Machine
        </button>
      </div>
    </aside>

    <header class="site-head">
      <a class="brand" href="/"><img src="/pactwright-mark.png" alt="" width="40" height="40" />Pactwright</a>
      <nav aria-label="Site">
        <a href="/docs/">Docs</a>
        <a href="/docs/quickstart/">Quickstart</a>
        <a href="/docs/project/status/">Status</a>
        <a href="https://github.com/Pactwright">GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-copy">
          <h1>Every agent purchase is a pact.</h1>
          <p class="lede">
            When an AI agent pays for something, Pactwright holds the money in escrow on Stellar until a verifier checks the
            delivery against terms agreed before payment. The seller is paid what the delivery earned; the rest goes back.
          </p>
          <div class="actions">
            <a class="cta" href="/docs/">Read the docs</a>
            <a class="quiet" href="/docs/concepts/lifecycle/">How a pact works</a>
          </div>
          <p class="fine"><span class="live-dot" aria-hidden="true"></span>Live on Stellar testnet. Not audited yet.</p>
        </div>

        <article class="panel pact-card" aria-label="A real pact on testnet">
          <header class="card-head">
            <div>
              <span class="label">Pact ID</span>
              <p class="pact-id mono">{PACT}</p>
            </div>
            <span class="seal" role="img" aria-label="Pactwright mark"><img src="/pactwright-mark.png" alt="" width="84" height="84" /></span>
          </header>
          <span class="stamp stamp--large" data-ink="teal">Settled</span>
          <dl class="fields">
            <div><dt class="label">Bought</dt><dd class="mono">A 4-page Portuguese translation</dd></div>
            <div><dt class="label">Cap</dt><dd class="mono">1.00 USDC</dd></div>
            <div><dt class="label">Paid to the seller</dt><dd class="mono">1.00 USDC</dd></div>
            <div><dt class="label">Returned to the buyer</dt><dd class="mono">0.00 USDC</dd></div>
            <div><dt class="label">Judged by</dt><dd class="mono">The hosted verifier, gemini-3.5-flash-lite</dd></div>
            <div><dt class="label">If no verdict in time</dt><dd class="mono">Refund the buyer</dd></div>
          </dl>
          <p class="card-foot">
            A real pact on testnet, 29 October 2026.{" "}
            <a href={`https://pactwright-studio.vercel.app/pact/${PACT}`}>See it in Studio</a>
          </p>
        </article>
      </section>

      <!-- The Section with 3 Switchable Options -->
      <section class="band" aria-labelledby="steps-title">
        <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 12px; margin-bottom: 24px;">
          <h2 id="steps-title" class="band-title" style="margin: 0;">The same pact, step by step</h2>
          <span style="font-family: var(--mono-face); font-size: 0.8125rem; color: var(--teal);" id="variant-indicator">
            Active: 1. Institutional Protocol Ledger
          </span>
        </div>

        <!-- Option 1: Institutional Protocol Ledger (Stellar / Stripe Style) -->
        <div class="variant-view active" id="view-opt1">
          <div class="inst-ledger-wrap">
            <div class="inst-ledger-header">
              <span>STATE</span>
              <span>LEDGER BLOCK</span>
              <span>VERIFIED OUTCOME</span>
              <span>STELLAR TX</span>
            </div>
            <ul class="inst-ledger-table">
              {steps.map((s) => (
                <li class="inst-ledger-row">
                  <div>
                    <span class={`inst-badge ${s.ink}`}>{s.stamp}</span>
                  </div>
                  <div class="inst-ledger-meta">
                    Ledger #{s.ledger}
                  </div>
                  <div class="inst-ledger-body">
                    <p>{s.text}</p>
                  </div>
                  <div class="inst-ledger-tx">
                    <a href={tx(s.hash)} target="_blank" rel="noreferrer">
                      {s.hash.slice(0, 8)}… ↗
                    </a>
                  </div>
                </li>
              ))}
            </ul>
          </div>
          <p class="band-note">
            Then the outcome becomes a receipt, anchored on-chain in a batch, so anyone can check later what was paid and why.
          </p>
        </div>

        <!-- Option 2: Godly Editorial Cards (Linear / Vercel Style) -->
        <div class="variant-view" id="view-opt2">
          <div class="editorial-grid">
            {steps.map((s) => (
              <article class="editorial-card">
                <div>
                  <div class="editorial-top">
                    <span class={`inst-badge ${s.ink}`}>{s.stamp}</span>
                    <span class="editorial-num">{s.num}</span>
                  </div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
                <div class="editorial-foot">
                  <span class="mono" style="color: var(--muted);">Ledger #{s.ledger}</span>
                  <a class="mono" href={tx(s.hash)} target="_blank" rel="noreferrer" style="color: var(--link);">
                    {s.hash.slice(0, 8)}… ↗
                  </a>
                </div>
              </article>
            ))}
          </div>
          <p class="band-note">
            Then the outcome becomes a receipt, anchored on-chain in a batch, so anyone can check later what was paid and why.
          </p>
        </div>

        <!-- Option 3: Cryptographic State Machine (DAG / Soroban Style) -->
        <div class="variant-view" id="view-opt3">
          <div class="state-dag-flow" role="tablist">
            {steps.map((s, idx) => (
              <button
                type="button"
                class={`state-node-btn ${idx === 0 ? "active" : ""}`}
                data-state-idx={idx}
                role="tab"
              >
                <span class="state-node-label">STEP {s.num} · LEDGER #{s.ledger}</span>
                <span class="state-node-name">{s.state}</span>
              </button>
            ))}
          </div>

          <div class="state-payload-inspector">
            <span class="state-payload-title" id="dag-state-title">// On-Chain Soroban Execution State: Step 01 (EscrowLocked)</span>
            <pre id="dag-payload-json">{JSON.stringify(steps[0].payload, null, 2)}</pre>
            <div style="margin-top: 14px; font-size: 0.8125rem; color: var(--muted); display: flex; justify-content: space-between;">
              <span id="dag-hash-ref">Tx Hash: b01031165b23c378d3fa9f5c9befbee0b1a733d944a89e1ce13e17ff290d1a5d</span>
              <a id="dag-tx-link" href={tx(steps[0].hash)} target="_blank" rel="noreferrer" style="color: var(--link);">
                View on Stellar Expert ↗
              </a>
            </div>
          </div>
          <p class="band-note">
            Cryptographic state mutations are verifiable on the Stellar ledger via independent Merkle receipts.
          </p>
        </div>
      </section>

      <!-- Original Section: What happens when a purchase goes wrong -->
      <section class="band" aria-labelledby="wrong-title">
        <div class="panel">
          <h2 id="wrong-title">What happens when a purchase goes wrong</h2>
          <p class="prose">An agent has no one to call. So the rules for getting money back are part of the payment.</p>
          <table class="ledger">
            <thead><tr><th scope="col">If</th><th scope="col">Then</th></tr></thead>
            <tbody>
              <tr><td>The delivery is wrong</td><td>The verifier signs DENY and the buyer gets the whole cap back</td></tr>
              <tr><td>Only part arrives</td><td>The seller is paid for what arrived; the rest returns, in the same transaction</td></tr>
              <tr><td>Nothing arrives</td><td>No verdict comes, and after the deadline the money goes back to the buyer</td></tr>
              <tr><td>The verifier goes silent</td><td>The same: the silence policy agreed up front applies</td></tr>
              <tr><td>The seller never collects</td><td>After the settle deadline, anyone can return the money to the buyer</td></tr>
              <tr><td>Someone forges or replays a verdict</td><td>Rejected: each verdict is signed and bound to one pact and one set of terms</td></tr>
            </tbody>
          </table>
          <p class="prose small">Nobody can move the escrow outside these rules. Not the seller, not the verifier, not the admin: there is no function that could.</p>
        </div>
      </section>

      <!-- Original Section: Where to start -->
      <section class="band" aria-labelledby="who-title">
        <h2 id="who-title" class="band-title">Where to start</h2>
        <div class="tiles">
          <a class="tile" href="/docs/guides/agent/">
            <h3>You build agents</h3>
            <p>Find a seller, buy under a pact, wait for the verdict and keep the certificate. As a TypeScript SDK or as MCP tools.</p>
            <span class="go">Buy as an agent</span>
          </a>
          <a class="tile" href="/docs/guides/seller/">
            <h3>You sell an API</h3>
            <p>One middleware call puts a route behind a pact: terms in the 402, payment checked before you serve, a signed receipt after.</p>
            <span class="go">Sell behind a pact</span>
          </a>
          <a class="tile" href="/docs/concepts/trust/">
            <h3>You want to check it</h3>
            <p>Who can do what, what the contract guarantees, the known limits, and the testnet transactions behind every claim.</p>
            <span class="go">Who you have to trust</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-foot">
      <p>
        Chat: <a href="https://discord.gg/4WFU6fwPe">Discord</a> · <a href="https://t.me/Pactwright">Telegram</a>.
        We will never DM you first, and there is no token or airdrop. Vulnerabilities go through a repo's
        <code>SECURITY.md</code>, never chat.
      </p>
      <p>
        Pactwright is open source:{" "}
        <a href="https://github.com/Pactwright/Pactwright-contracts">contracts</a> (MIT),{" "}
        <a href="https://github.com/Pactwright/Pactwright-Kit">Kit</a> (Apache-2.0) and{" "}
        <a href="https://github.com/Pactwright/Pactwright-studio">Studio</a> (MIT). Built on Witness, Accensa and Tollcraft.
      </p>
      <p>Runs on Stellar testnet. Not audited, so don't put real money in it yet.</p>
    </footer>

    <script define:vars={{ steps }}>
      // Option variant switcher
      const optionButtons = document.querySelectorAll(".option-btn");
      const variantViews = document.querySelectorAll(".variant-view");
      const indicator = document.getElementById("variant-indicator");

      const titles = {
        opt1: "Active: 1. Institutional Protocol Ledger",
        opt2: "Active: 2. Godly Editorial Cards",
        opt3: "Active: 3. Cryptographic State Machine",
      };

      optionButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          optionButtons.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");

          const variant = btn.getAttribute("data-variant");
          variantViews.forEach((view) => {
            if (view.id === `view-${variant}`) {
              view.classList.add("active");
            } else {
              view.classList.remove("active");
            }
          });

          if (indicator && variant && titles[variant]) {
            indicator.textContent = titles[variant];
          }
        });
      });

      // DAG State machine inspector
      const dagButtons = document.querySelectorAll(".state-node-btn");
      const dagTitle = document.getElementById("dag-state-title");
      const dagJson = document.getElementById("dag-payload-json");
      const dagHash = document.getElementById("dag-hash-ref");
      const dagLink = document.getElementById("dag-tx-link");

      dagButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          dagButtons.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");

          const idx = Number(btn.getAttribute("data-state-idx"));
          const step = steps[idx];
          if (!step) return;

          if (dagTitle) dagTitle.textContent = `// On-Chain Soroban Execution State: Step ${step.num} (${step.state})`;
          if (dagJson) dagJson.textContent = JSON.stringify(step.payload, null, 2);
          if (dagHash) dagHash.textContent = `Tx Hash: ${step.hash}`;
          if (dagLink) dagLink.setAttribute("href", `https://stellar.expert/explorer/testnet/tx/${step.hash}`);
        });
      });
    </script>
  </body>
</html>
